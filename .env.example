# News Portal — environment variables
# Copy this file to .env and fill in values

# App secret key (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=change-me-to-a-random-string

# Groq API key (free tier: https://console.groq.com)
GROQ_API_KEY=

# Admin key for on-demand refresh (generate your own)
ADMIN_KEY=change-me-to-a-random-string

# Optional: Reddit API credentials (works without, but higher rate limits with)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=GamingNewsPL/1.0
